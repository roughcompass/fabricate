{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2024"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@deweb/portal": [
        "./src/demo/runtime/portal"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-check/types/**/*.ts",
    ".next-check/dev/types/**/*.ts",
    ".next-webpack-check/types/**/*.ts",
    ".next-webpack-check/dev/types/**/*.ts",
    ".next-dryrun/types/**/*.ts",
    ".next-dryrun/dev/types/**/*.ts",
    ".next-aps-build/types/**/*.ts",
    ".next-aps-build/dev/types/**/*.ts",
    ".next-e2e-b/types/**/*.ts",
    ".next-e2e-b/dev/types/**/*.ts",
    ".next-e2e-aps/types/**/*.ts",
    ".next-e2e-aps/dev/types/**/*.ts",
    ".next-e2e-demo-off/types/**/*.ts",
    ".next-e2e-demo-off/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "storage",
    "tmp",
    ".next",
    ".next-e2e"
  ]
}
