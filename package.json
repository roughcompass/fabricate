{
  "name": "fabricate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,worker --prefix-colors blue,magenta --passthrough-arguments \"npm:dev:web -- {@}\" \"npm:dev:worker\" --",
    "dev:web": "next dev",
    "dev:worker": "node scripts/dev-worker.mjs",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild worker=src/worker/main.ts migrate=src/lib/db/migrate-cli.ts --bundle --platform=node --target=node24 --format=cjs --external:better-sqlite3 --external:@repo-facts/* --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "start": "next start",
    "worker": "node dist/worker.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate-cli.ts",
    "config": "tsx src/lib/config/print-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "CAPTURE_SCREENSHOTS=1 playwright test e2e/visual.spec.ts",
    "test:fleet": "playwright test --config playwright.fleet.config.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@repo-facts/bundle": "0.2.0",
    "@repo-facts/contract": "0.2.0",
    "axe-core": "4.13.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "geist": "1.7.2",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
