{
  "name": "fabricate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-prototype-runtime.mjs && concurrently --kill-others --names web,worker --prefix-colors blue,magenta --passthrough-arguments \"npm:dev:web -- {@}\" \"npm:dev:worker\" --",
    "dev:web": "next dev",
    "dev:worker": "node scripts/dev-worker.mjs",
    "build": "node scripts/build-prototype-runtime.mjs && next build && npm run build:worker",
    "build:worker": "esbuild worker=src/worker/main.ts migrate=src/lib/db/migrate-cli.ts projection-rebuild=src/lib/projection/rebuild-cli.ts --bundle --platform=node --target=node24 --format=cjs --external:better-sqlite3 --external:@repo-facts/* --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "start": "next start",
    "worker": "node dist/worker.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate-cli.ts",
    "prototypes:generate": "drizzle-kit generate --config drizzle.prototypes.config.ts",
    "prototypes:migrate": "tsx src/lib/prototypes/db/migrate-cli.ts",
    "projection:rebuild": "tsx src/lib/projection/rebuild-cli.ts",
    "config": "tsx src/lib/config/print-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "CAPTURE_SCREENSHOTS=1 playwright test e2e/visual.spec.ts",
    "test:fleet": "playwright test --config playwright.fleet.config.ts",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "test:demo-off": "playwright test --config playwright.demo-off.config.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "prototypes:runtime": "node scripts/build-prototype-runtime.mjs",
    "prototypes:registry": "node scripts/build-salt-registry.mjs",
    "heroes:generate": "tsx scripts/generate-heroes.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.146",
    "@ai-sdk/workflow": "2.0.74",
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/pt-mono": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@repo-facts/bundle": "0.3.0",
    "@repo-facts/contract": "0.3.0",
    "@salt-ds/ag-grid-theme": "2.11.0",
    "@salt-ds/core": "1.75.0",
    "@salt-ds/countries": "1.5.4",
    "@salt-ds/date-adapters": "1.0.2",
    "@salt-ds/date-components": "1.1.4",
    "@salt-ds/icons": "1.19.0",
    "@salt-ds/lab": "1.0.0-alpha.108",
    "@salt-ds/mcp": "0.0.0-snapshot-20260317135132",
    "@salt-ds/styles": "0.4.2",
    "@salt-ds/theme": "1.48.0",
    "@vercel/sandbox": "3.8.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ai": "7.0.142",
    "axe-core": "4.13.0",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "geist": "1.7.2",
    "html-to-image": "1.11.13",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "workflow": "5.2.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
