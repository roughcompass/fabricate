{
  "name": "frontend-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,worker --prefix-colors blue,magenta --passthrough-arguments \"npm:dev:web -- {@}\" \"npm:dev:worker\" --",
    "dev:web": "next dev",
    "dev:worker": "node scripts/dev-worker.mjs",
    "build": "next build && npm run build:worker",
    "build:inspector": "tsx scripts/build-inspector.ts",
    "build:worker": "esbuild worker=src/worker/main.ts migrate=src/lib/db/migrate-cli.ts vacuum=src/lib/db/vacuum-cli.ts projection-rebuild=src/lib/projection/rebuild-cli.ts previews-doctor=src/lib/previews/doctor-cli.ts --bundle --platform=node --target=node24 --format=cjs --external:better-sqlite3 --external:@repo-facts/* --external:playwright-core --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "start": "next start",
    "release": "node scripts/release.mjs",
    "worker": "node dist/worker.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate-cli.ts",
    "db:vacuum": "tsx src/lib/db/vacuum-cli.ts",
    "projection:rebuild": "tsx src/lib/projection/rebuild-cli.ts",
    "config": "tsx src/lib/config/print-cli.ts",
    "previews:doctor": "tsx src/lib/previews/doctor-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "CAPTURE_SCREENSHOTS=1 playwright test e2e/visual.spec.ts",
    "test:fleet": "playwright test --config playwright.fleet.config.ts",
    "test:previews-off": "playwright test --config playwright.previews-off.config.ts",
    "lint": "eslint --max-warnings=0 .",
    "knip": "knip && knip --production --config knip.production.json",
    "typecheck": "next typegen && tsc --noEmit",
    "duplication": "jscpd --min-lines 8 --min-tokens 70 --threshold 0.5 --reporters console src test e2e scripts",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run duplication && npm test"
  },
  "dependencies": {
    "@repo-facts/bundle": "0.7.0",
    "@repo-facts/catalog-builder": "0.7.0",
    "@repo-facts/contract": "0.7.0",
    "axe-core": "4.14.1",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.2",
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.7",
    "next": "16.4.6",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "web-vitals": "6.2.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "hast-util-to-html": "9.0.7",
    "jscpd": "4.3.0",
    "knip": "6.45.1",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
