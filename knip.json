{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/worker/main.ts", "scripts/*.{mjs,ts}", "src/components/toolbar/inspector/inspector.ts"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}", "test/**/*.ts", "e2e/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": ["worker=src/worker/main.ts"],
  "ignoreBinaries": ["openssl"]
}
