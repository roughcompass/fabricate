{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/worker/main.ts", "scripts/*.{mjs,ts}"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}", "test/**/*.ts", "e2e/**/*.ts"],
  "ignore": ["src/demo/runtime/generated/**"],
