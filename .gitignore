# Dependencies and build output
/node_modules
/.next
/.next-*
/dist
/next-env.d.ts
*.tsbuildinfo

# Databases, managed Git object databases, and scratch space
/storage/*
!/storage/.keep
/tmp

# Test output
/test-results
/test-results-*
/playwright-report
/blob-report

# Local environment
/.env*
!/.env.example
.DS_Store
/.vercel

# Built by scripts/build-prototype-runtime.mjs before dev and build
/public/prototype-runtime

# Vercel Workflow's local world
/.workflow-data
/.swc
